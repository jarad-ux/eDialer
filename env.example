# ===========================================
# eDialer Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ===========================================

# ----- DATABASE -----
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/edialer?schema=public"

# ----- RETELL AI -----
# Your Retell AI API key for voice AI agents
# Get from: https://dashboard.retell.ai/
RETELL_API_KEY="your_retell_api_key_here"

# Retell Agent IDs (create these in Retell dashboard)
RETELL_AGENT_ID="agent_..."
RETELL_INBOUND_AGENT_ID="agent_..."

# ----- TWILIO -----
# Twilio Account credentials
# Get from: https://console.twilio.com/
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# ----- ANTHROPIC (Claude AI) -----
# For MCP integration and AI features
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# ----- APPLICATION -----
# Base URL of your deployed application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth secret for session encryption (generate with: openssl rand -base64 32)
NEXTAUTH_SECRET="your_nextauth_secret_here"
NEXTAUTH_URL="http://localhost:3000"

# ----- OPTIONAL: EXTERNAL SERVICES -----
# CRM Integration (if applicable)
# CRM_API_URL=""
# CRM_API_KEY=""

# Email Service (for notifications)
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASSWORD=""

# ----- MCP SERVER -----
# MCP server configuration for Claude integration
MCP_SERVER_PORT="8080"
MCP_SERVER_HOST="localhost"
